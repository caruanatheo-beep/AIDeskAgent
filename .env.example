# AI Sales Desk Assistant: copy this file to .env for local use.
# Never add a real credential to this example file or commit your .env.

# Public market, news and calendar sources do not require credentials.

# Optional documented FRED API fallback. The dashboard first uses the public
# CSV download, which requires no key. Leave blank unless you have a FRED key.
FRED_API_KEY=

# Optional model inference. False keeps the safe deterministic assistant.
ENABLE_LLM=false

# Required only if ENABLE_LLM=true. Options: huggingface, openai_compatible.
LLM_PROVIDER=huggingface

# Required only if ENABLE_LLM=true. Replace with a model supported by your provider.
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct:featherless-ai

# Required only for the Hugging Face inference provider. Add the real token to .env
# locally or as a Hugging Face Space Secret. Leave this placeholder unchanged here.
HF_TOKEN=your_hugging_face_token_here

# Required only for an OpenAI-compatible provider.
OPENAI_API_KEY=your_provider_api_key_here

# Optional for an OpenAI-compatible provider.
OPENAI_BASE_URL=https://api.openai.com/v1

# Public-cost safety. Keep false for a public anonymous Space unless you have a
# separate authentication/budget layer. Deterministic answers remain available.
ALLOW_PUBLIC_LLM=false

# Optional bounded reliability and cost controls.
REQUEST_TIMEOUT_SECONDS=8
CACHE_TTL_SECONDS=900
LIVE_CACHE_TTL_SECONDS=60
MAX_LLM_CALLS_PER_SESSION=5
LLM_COOLDOWN_SECONDS=10
MAX_NEWS_ITEMS=10
MAX_AGENT_STEPS=4
MAX_TOOL_CALLS_PER_SESSION=18
MAX_CALLS_PER_TOOL=4
MAX_MEMORY_TURNS=6
MAX_CONTEXT_CHARS=18000

# Bounded official-domain search. Disable if the deployment forbids outbound search.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_RESULTS=5
PREFERRED_REGIONS=United States,Euro Area,United Kingdom

# Optional local server settings. Hugging Face sets its own environment.
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
